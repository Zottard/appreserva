# En dev probablemente sea http://localhost:3001/api/v1/pwa
API_URL="https://back.tourexperto.com/api/v1/pwa"
# Dev: https://img-dev.tourexperto.com/ — Prod: https://imagenes.tourexperto.com/
IMAGES_URL="https://img-dev.tourexperto.com/"

# Server-only — nunca se expone al cliente, lo agrega el proxy en server/api/pwa/[...path].ts
BACKEND_TOKEN=""

# true = server/middleware/mock.ts responde con fixtures locales en vez de pegarle al back.
# Sólo funciona en `pnpm dev`; en build de producción el mock no se ejecuta nunca.
# Los archivos del mock están gitignoreados — ver CLAUDE.md § Mock local.
NUXT_USE_MOCK=false
